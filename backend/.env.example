# =============================================================================
# ЛОКАЛЬНО (скопируйте в .env: cp .env.example .env)
# =============================================================================

# development | production (в prod — проверка секретов при старте)
APP_ENV=development

# PostgreSQL — для docker-compose (сервис db)
POSTGRES_USER=autohub
POSTGRES_PASSWORD=autohub
POSTGRES_DB=autohub

# Только если API запускаете на хосте без Docker (uvicorn).
# В Docker compose подставляет @db:5432 автоматически.
DATABASE_URL=postgresql+psycopg2://autohub:autohub@localhost:5432/autohub

SECRET_KEY=change-me-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

MEDIA_ROOT=uploads
PUBLIC_MEDIA_URL=http://127.0.0.1:8000/media

# =============================================================================
# ПРОД (VPS: /opt/Autohub/backend/.env)
# =============================================================================
#
# APP_ENV=production
# POSTGRES_USER=autohub
# POSTGRES_PASSWORD=<надёжный-пароль>
# POSTGRES_DB=autohub
#
# SECRET_KEY=<openssl rand -hex 32>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<надёжный-пароль>
#
# MEDIA_ROOT=uploads
# PUBLIC_MEDIA_URL=https://www.example.com/media
